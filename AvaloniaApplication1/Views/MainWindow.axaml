<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Todo List"
        Width="700" Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBox x:Name="NameBox" PlaceholderText="Название" />
            <TextBox x:Name="DescriptionBox" PlaceholderText="Описание"
                     Height="60" AcceptsReturn="True" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Срок:" />
                <DatePicker x:Name="DueDatePicker" Width="150" />
                <TextBlock VerticalAlignment="Center" Text="Приоритет:" />
                <ComboBox x:Name="PriorityBox" Width="130" />
                <TextBlock VerticalAlignment="Center" Text="Статус:" />
                <ComboBox x:Name="StatusBox" Width="140" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Добавить" Click="AddButton_Click" />
                <Button Content="Сохранить изменения" Click="SaveButton_Click" />
                <Button Content="Удалить" Click="DeleteButton_Click" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="TasksList" Grid.Row="1" Margin="0,10"
                 SelectionChanged="TasksList_SelectionChanged" />

        <StackPanel Grid.Row="2" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Сохранить в JSON" Click="SaveToFileButton_Click" />
                <Button Content="Загрузить из JSON" Click="LoadFromFileButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
